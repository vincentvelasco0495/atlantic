# Frontend environment variables (Vite)
# Copy this file to .env and adjust as needed:
#   copy .env.example .env

# API base URL used by src/config/api.js
# Leave empty for local dev — Vite will proxy /api to http://127.0.0.1:8000
# Set this for production builds, e.g. https://api.yourdomain.com
VITE_API_URL=
