# Frontend environment variables (Vite)
# Copy this file to .env and adjust as needed:
#   copy .env.example .env

# API base URL used by src/config/api.js
#
# LOCAL DEV: leave empty — Vite proxies /api to http://127.0.0.1:8000
#
# NETLIFY / PRODUCTION: set to your deployed Laravel API URL (required!)
# Example: https://api.yourdomain.com
# Also add this in Netlify: Site settings → Environment variables → VITE_API_URL
# Then trigger a new deploy (env vars are baked in at build time).
VITE_API_URL=
